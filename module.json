{
	"id": "pf2e-graphics-tonval",
	"title": "PF2e Graphics Tonval's Stash",
	"version": "0.0.1",
	"description": "<i>Provides animations for the PF2e system. Tonval's stash.</i>",
	"socket": true,
	"esmodules": [
		"dist/pf2e-graphics.js"
	],
	"styles": [
		"dist/pf2e-graphics.css"
	],
	"languages": [
		{
			"lang": "en",
			"name": "English",
			"path": "lang/en.json"
		},
		{
			"lang": "pl",
			"name": "Polski",
			"path": "lang/pl.json"
		}
	],
	"compatibility": {
		"minimum": "12.324",
		"verified": "13",
		"maximum": "13"
	},
	"flags": {
		"pf2e-graphics": {
			"path": "dist/animations.json"
		},
		"hotReload": {
			"extensions": [
				"json",
				"css"
			]
		}
	},
	"relationships": {
		"requires": [
			{
				"id": "sequencer",
				"type": "module",
				"manifest": "https://github.com/fantasycalendar/FoundryVTT-Sequencer/releases/latest/download/module.json",
				"compatibility": {
					"minimum": "3.4.8"
				}
			},
			{
				"id": "socketlib",
				"type": "module"
			}
		],
		"systems": [
			{
				"id": "pf2e",
				"type": "system",
				"manifest": "https://raw.githubusercontent.com/foundryvtt/pf2e/master/system.json",
				"compatibility": {
					"minimum": "6.8.1"
				}
			}
		]
	},
	"authors": [
		{
			"name": "Vauxs",
			"url": "mrvauxs.net",
			"discord": "vauxs",
			"twitter": "@ThatVauxs",
			"email": "mrvauxs@gmail.com",
			"ko-fi": "MrVauxs",
			"flags": {}
		},
		{
			"name": "Spappz",
			"discord": "spap",
			"ko-fi": "spappz",
			"flags": {}
		}
	]
}
